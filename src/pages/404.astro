---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { cvFilename, resume } from '../lib/resume';
---

<Layout title={`Page not found · ${resume.basics.name}`} description="This page doesn't exist.">
  <section class="relative isolate flex min-h-svh items-center overflow-hidden px-6 py-32">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="animate-aurora absolute top-1/4 left-1/3 size-[32rem] rounded-full bg-violet/20 blur-[120px]"></div>
    </div>
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-display text-[9rem] leading-none font-extrabold tracking-tighter text-gradient sm:text-[12rem]">404</p>
      <h1 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">This page has gone off the map.</h1>
      <p class="mt-4 text-lg text-muted">The link may be old, or the page may have moved.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3 font-semibold text-ink transition hover:bg-cyan">
          <Icon name="back" class="size-4" /> Back home
        </a>
        <a href="/blog" data-astro-prefetch class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 font-semibold transition hover:bg-fg/5">Read the blog</a>
        <a href="/cv.pdf" download={cvFilename} class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 font-semibold transition hover:bg-fg/5">
          <Icon name="download" class="size-4" /> CV
        </a>
      </div>
    </div>
  </section>
</Layout>
