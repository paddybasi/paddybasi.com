---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, getPosts, readingTime, type Post } from '../../lib/blog';
import { cvFilename, derived, resume } from '../../lib/resume';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
---

<Layout title={`${title} · ${resume.basics.name}`} {description} article={{ published: pubDate, updated: updatedDate, tags }}>
  <article class="px-6 pt-36 pb-20">
    <header class="mx-auto max-w-3xl">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-muted transition hover:text-fg">
        <Icon name="back" class="size-4" /> All posts
      </a>
      <p class="mt-10 font-mono text-xs text-cyan">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body)}
        {updatedDate && <span class="text-muted"> · updated {formatDate(updatedDate)}</span>}
      </p>
      <h1 class="mt-4 font-display text-4xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-6xl">{title}</h1>
      <p class="mt-6 text-xl leading-relaxed text-muted">{description}</p>
      <ul class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((t) => <li class="rounded-md bg-fg/5 px-2 py-0.5 font-mono text-xs text-muted">{t}</li>)}
      </ul>
      <div class="mt-10 h-px bg-gradient-to-r from-violet via-cyan to-transparent"></div>
    </header>

    <div class="prose prose-lg prose-site mx-auto mt-12 max-w-3xl">
      <Content />
    </div>
    <!-- Reaching the end of a post completes the "Bookworm" quest. -->
    <div data-quest="blog" aria-hidden="true" class="h-px"></div>

    <!-- Recruiter hook -->
    <aside class="card mx-auto mt-20 max-w-3xl p-8 sm:p-10">
      <p class="eyebrow">Hiring?</p>
      <p class="mt-3 font-display text-3xl font-bold tracking-tight">
        {derived.available ? "I'm available for new roles and contracts." : "Let's talk about your project."}
      </p>
      <p class="mt-2 text-muted">{resume.basics.label} · {derived.years}+ years · {derived.location}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/cv.pdf" download={cvFilename} class="inline-flex items-center gap-2 rounded-full bg-fg px-5 py-3 font-semibold text-ink transition hover:bg-cyan">
          <Icon name="download" class="size-4" /> Download CV
        </a>
        <a href="/#contact" class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-3 font-semibold transition hover:bg-fg/5">
          Get in touch <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </aside>

    {
      (newer || older) && (
        <nav aria-label="More posts" class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
          {older && (
            <a href={`/blog/${older.id}`} class="card p-6">
              <span class="font-mono text-xs text-muted">← Older</span>
              <span class="mt-2 block font-display text-lg font-bold">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a href={`/blog/${newer.id}`} class="card p-6 text-right sm:col-start-2">
              <span class="font-mono text-xs text-muted">Newer →</span>
              <span class="mt-2 block font-display text-lg font-bold">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Layout>
