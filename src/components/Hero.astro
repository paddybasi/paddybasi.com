---
import Icon from './Icon.astro';
import HeroScene from './HeroScene';
import { shortTag } from '../lib/format';
import { cvFilename, derived, resume, topTags } from '../lib/resume';

const { basics } = resume;
const [first, ...rest] = basics.name.split(' ');
const pitch = basics.summary?.split('. ')[0] + '.';
const socials = basics.profiles ?? [];
---

<section id="top" class="relative isolate flex min-h-svh items-center overflow-hidden px-6 pt-32 pb-20">
  <!-- Aurora + grid backdrop -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="animate-aurora absolute -top-40 -left-32 size-[38rem] rounded-full bg-violet/25 blur-[120px]"></div>
    <div class="animate-aurora absolute top-20 right-[-10rem] size-[34rem] rounded-full bg-cyan/20 blur-[120px] [animation-delay:-6s]"></div>
    <div class="animate-aurora absolute bottom-[-12rem] left-1/3 size-[30rem] rounded-full bg-lime/10 blur-[120px] [animation-delay:-12s]"></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-line)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"
    >
    </div>
  </div>

  <div class="mx-auto grid w-full max-w-6xl items-center gap-10 lg:grid-cols-[1.3fr_1fr]">
    <div class="relative z-10">
      {
        derived.available && (
          <p data-reveal class="mb-8 inline-flex items-center gap-2.5 rounded-full border border-lime/30 bg-lime/10 px-4 py-1.5 text-sm text-lime">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-lime opacity-75" />
              <span class="relative inline-flex size-2 rounded-full bg-lime" />
            </span>
            Available for new opportunities
          </p>
        )
      }

      <h1 data-reveal style="--d:1" class="font-display text-6xl leading-[0.9] font-extrabold tracking-tight text-balance sm:text-7xl lg:text-8xl">
        {first}<br />
        <span class="text-gradient">{rest.join(' ')}</span>
      </h1>

      <p data-reveal style="--d:2" class="mt-8 font-display text-2xl font-medium text-fg/90 sm:text-3xl">{basics.label}</p>
      <p data-reveal style="--d:3" class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{pitch}</p>

      <div data-reveal style="--d:4" class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/cv.pdf"
          download={cvFilename}
          class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-violet via-cyan to-lime px-6 py-3.5 font-semibold text-white shadow-[0_10px_40px_-10px] shadow-cyan/60 transition hover:scale-[1.03] dark:text-ink"
        >
          <Icon name="download" class="size-5 transition group-hover:translate-y-0.5" /> Download CV
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-fg/5 px-6 py-3.5 font-semibold backdrop-blur transition hover:border-fg/30 hover:bg-fg/10"
        >
          Get in touch <Icon name="arrow" class="size-4" />
        </a>
        <ul class="ml-1 flex items-center gap-1">
          {
            socials.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  rel="me noopener"
                  aria-label={`${p.network}: ${p.username}`}
                  class="grid size-11 place-items-center rounded-full text-muted transition hover:bg-fg/5 hover:text-fg"
                >
                  <Icon name={p.network} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Interactive 3D scene -->
    <div data-reveal style="--d:2" class="relative mx-auto aspect-square w-full max-w-md lg:max-w-none">
      <div class="absolute -inset-[15%]">
        <HeroScene client:only="react" />
      </div>

      <div class="pointer-events-none absolute top-[6%] left-0 rounded-2xl border border-line bg-ink/70 px-4 py-3 backdrop-blur-xl">
        <p class="font-display text-3xl font-bold"><span class="text-gradient">{derived.years}+</span></p>
        <p class="text-xs text-muted">years shipping</p>
      </div>
      <div class="pointer-events-none absolute right-0 bottom-[8%] flex max-w-[15rem] flex-wrap gap-1.5 rounded-2xl border border-line bg-ink/70 p-3 backdrop-blur-xl">
        {topTags.slice(0, 4).map((t) => <span class="rounded-full bg-fg/5 px-2.5 py-1 font-mono text-[11px] text-fg/80">{shortTag(t)}</span>)}
      </div>
      <p class="absolute inset-x-0 -bottom-6 text-center font-mono text-[11px] tracking-widest text-muted uppercase">
        <span class="hidden sm:inline">Hover</span><span class="sm:hidden">Tap</span> the orb · {derived.location}
      </p>
    </div>
  </div>

  <a href="#about" aria-label="Scroll to about" class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 text-muted transition hover:text-fg lg:block">
    <span class="block h-10 w-6 rounded-full border-2 border-current p-1">
      <span class="mx-auto block h-2 w-1 animate-bounce rounded-full bg-current"></span>
    </span>
  </a>
</section>
