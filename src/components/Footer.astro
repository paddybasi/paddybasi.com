---
import Icon from './Icon.astro';
import { resume } from '../lib/resume';

const { basics } = resume;
---

<footer class="border-t border-line px-6 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-sm text-muted sm:flex-row">
    <p>© {new Date().getFullYear()} {basics.name}</p>
    <ul class="flex gap-1">
      <li>
        <a href="/rss.xml" aria-label="RSS feed" class="grid size-10 place-items-center rounded-full transition hover:bg-fg/5 hover:text-fg">
          <Icon name="rss" class="size-4" />
        </a>
      </li>
      {
        basics.profiles?.map((p) => (
          <li>
            <a
              href={p.url}
              target="_blank"
              rel="me noopener"
              aria-label={p.network}
              class="grid size-10 place-items-center rounded-full transition hover:bg-fg/5 hover:text-fg"
            >
              <Icon name={p.network} class="size-4" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
