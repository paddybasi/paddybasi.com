---
import Icon from './Icon.astro';
import { cvFilename } from '../lib/resume';

const links = [
  ['About', '/#about'],
  ['Skills', '/#skills'],
  ['Experience', '/#experience'],
  ['Blog', '/blog'],
  ['Contact', '/#contact'],
];
const path = Astro.url.pathname;
const current = (href: string) => (href.startsWith('/#') ? undefined : path.startsWith(href) ? 'page' : undefined);
---

<header class="fixed inset-x-0 top-3 z-50 px-3 md:top-4 md:px-4">
  <div
    id="site-nav"
    class="mx-auto max-w-5xl rounded-[1.75rem] border border-line bg-ink/70 shadow-[0_10px_40px_-20px] shadow-fg/20 backdrop-blur-xl"
  >
    <nav aria-label="Primary" class="flex items-center gap-2 py-2 pr-2 pl-5">
      <a href="/" class="mr-auto font-display text-lg font-bold tracking-tight" aria-label="Home">
        <span class="text-gradient">PB</span><span class="text-muted">.</span>
      </a>

      <!-- Inline links from md up -->
      <ul class="hidden items-center gap-1 text-sm text-muted md:flex">
        {
          links.map(([label, href]) => (
            <li>
              <a
                href={href}
                aria-current={current(href)}
                class="rounded-full px-3 py-1.5 transition hover:bg-fg/5 hover:text-fg aria-[current=page]:bg-fg/10 aria-[current=page]:text-fg"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-1 md:ml-auto">
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle colour theme"
          class="grid size-10 place-items-center rounded-full text-muted transition hover:bg-fg/5 hover:text-fg"
        >
          <Icon name="sun" class="size-5 dark:hidden" />
          <Icon name="moon" class="hidden size-5 dark:block" />
        </button>
        <div class="relative">
          <button
            type="button"
            data-mode-toggle
            data-nav-mode
            aria-label="Adventure mode"
            aria-pressed="false"
            class="new-dot relative grid size-10 place-items-center rounded-full text-muted transition hover:bg-fg/5 hover:text-fg aria-pressed:bg-violet/15 aria-pressed:text-violet"
          >
            <Icon name="sword" class="size-5" />
          </button>

          <!-- One-time nudge for first-time visitors (shown by the script below). -->
          <div
            data-mode-callout
            hidden
            role="dialog"
            aria-label="Adventure mode"
            class="quest-panel fixed inset-x-3 top-[4.5rem] rounded-2xl border border-line bg-ink-2/95 p-4 text-left shadow-2xl shadow-violet/30 backdrop-blur-xl sm:absolute sm:inset-x-auto sm:top-full sm:right-0 sm:mt-4 sm:w-64"
          >
            <span aria-hidden="true" class="absolute -top-1.5 right-4 hidden size-3 rotate-45 border-t border-l border-line bg-ink-2 sm:block"></span>
            <p class="font-mono text-[10px] tracking-widest text-lime uppercase">New · Adventure mode</p>
            <p class="mt-1.5 text-sm leading-relaxed text-fg/85">Play this CV like a retro RPG: pixel art, a heart meter and chiptune unlocks.</p>
            <div class="mt-3 flex items-center gap-2">
              <button type="button" data-mode-toggle class="inline-flex items-center gap-1.5 rounded-full bg-fg px-3.5 py-1.5 text-sm font-semibold text-ink transition hover:bg-cyan">
                <Icon name="sword" class="size-4" /> Try it
              </button>
              <button type="button" data-callout-dismiss class="rounded-full px-3 py-1.5 text-sm text-muted transition hover:text-fg">Not now</button>
            </div>
          </div>
        </div>
        <a
          href="/cv.pdf"
          download={cvFilename}
          class="inline-flex items-center gap-2 rounded-full bg-fg px-4 py-2 text-sm font-semibold text-ink transition hover:bg-cyan"
        >
          <Icon name="download" class="size-4" /> CV
        </a>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
          class="burger grid size-10 place-items-center rounded-full transition hover:bg-fg/5 md:hidden"
        >
          <span class="relative block h-3.5 w-5" aria-hidden="true">
            <span class="absolute top-0 left-0 h-0.5 w-full rounded-full bg-current"></span>
            <span class="absolute top-1.5 left-0 h-0.5 w-full rounded-full bg-current"></span>
            <span class="absolute top-3 left-0 h-0.5 w-full rounded-full bg-current"></span>
          </span>
        </button>
      </div>
    </nav>

    <!-- Collapsible panel below md -->
    <div id="mobile-menu" class="menu md:hidden">
      <div class="overflow-hidden">
        <ul class="border-t border-line px-3 pt-2 pb-3">
          {
            links.map(([label, href], i) => (
              <li style={`--i:${i}`}>
                <a
                  href={href}
                  aria-current={current(href)}
                  class="flex items-center justify-between rounded-2xl px-3 py-3 font-display text-2xl font-semibold tracking-tight transition hover:bg-fg/5 aria-[current=page]:text-cyan"
                >
                  {label}
                  <Icon name="arrow" class="size-5 text-muted" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  /* Hamburger → X */
  .burger span span {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s;
  }
  .burger[aria-expanded='true'] span span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .burger[aria-expanded='true'] span span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Panel: expanded without JS; collapsed by default once JS is running. */
  .menu {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s;
  }
  :global(.js) .menu:not([data-open]) {
    grid-template-rows: 0fr;
    opacity: 0;
  }
  .menu li {
    transition:
      opacity 0.35s,
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }
  :global(.js) .menu:not([data-open]) li {
    opacity: 0;
    transform: translateY(-8px);
    transition-delay: 0ms;
  }
</style>

<script>
  import { unlock } from '../lib/quests';

  const root = document.documentElement;

  /** Run a DOM change through a View Transition where supported; `iris` swaps the cross-fade for an iris wipe. */
  const transition = (apply: () => void, iris = false) => {
    if (!('startViewTransition' in document) || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
    root.classList.toggle('iris', iris);
    document.startViewTransition(apply).finished.finally(() => root.classList.remove('iris'));
  };

  // Theme toggle
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncTheme = () => themeButton.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  syncTheme();
  themeButton.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {}
    unlock('theme');
    transition(() => {
      root.dataset.theme = next;
      syncTheme();
    });
  });

  // Adventure mode: any [data-mode-toggle] (nav sword, callout, hero link) flips it.
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode-toggle]');
  const navModeButton = document.querySelector<HTMLButtonElement>('[data-nav-mode]')!;
  const callout = document.querySelector<HTMLElement>('[data-mode-callout]')!;
  const syncMode = () => modeButtons.forEach((b) => b.hasAttribute('aria-pressed') && b.setAttribute('aria-pressed', String(root.dataset.mode === 'adventure')));
  syncMode();

  // Discovery cues: "new" dot on the sword + one-time callout, until tried or dismissed.
  const SEEN_KEY = 'mode-seen';
  const seen = () => {
    try {
      return root.dataset.mode === 'adventure' || !!localStorage.getItem(SEEN_KEY);
    } catch {
      return true; // no storage: don't nag on every page
    }
  };
  const markSeen = () => {
    try {
      localStorage.setItem(SEEN_KEY, '1');
    } catch {}
    navModeButton.removeAttribute('data-new');
    callout.hidden = true;
  };
  if (!seen()) {
    navModeButton.setAttribute('data-new', '');
    // After the quest intro toast (2.5s + 4.2s on screen) so the two nudges don't stack.
    setTimeout(() => {
      if (!seen()) callout.hidden = false;
    }, 7000);
  }
  document.querySelector('[data-callout-dismiss]')!.addEventListener('click', () => {
    markSeen();
    navModeButton.focus();
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !callout.hidden && markSeen());

  modeButtons.forEach((button) =>
    button.addEventListener('click', (e) => {
      const on = root.dataset.mode !== 'adventure';
      try {
        on ? localStorage.setItem('mode', 'adventure') : localStorage.removeItem('mode');
      } catch {}
      // Iris opens from the click point (or the button's centre for keyboard activation).
      // Measure before markSeen() hides the callout this button may live in.
      const r = button.getBoundingClientRect();
      root.style.setProperty('--iris-x', `${e.detail ? e.clientX : r.left + r.width / 2}px`);
      root.style.setProperty('--iris-y', `${e.detail ? e.clientY : r.top + r.height / 2}px`);
      markSeen();
      transition(() => {
        if (on) root.dataset.mode = 'adventure';
        else delete root.dataset.mode;
        syncMode();
      }, true);
      if (on) unlock('adventure');
    }),
  );

  // Mobile menu
  const shell = document.getElementById('site-nav')!;
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.getElementById('mobile-menu')!;

  const setOpen = (open: boolean) => {
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.toggleAttribute('data-open', open);
    menu.inert = !open; // keep collapsed links out of the tab order
  };
  setOpen(false);

  menuButton.addEventListener('click', () => setOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => (e.target as Element).closest('a') && setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.hasAttribute('data-open')) {
      setOpen(false);
      menuButton.focus();
    }
  });
  document.addEventListener('click', (e) => !shell.contains(e.target as Node) && setOpen(false));
  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
