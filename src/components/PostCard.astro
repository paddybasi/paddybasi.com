---
import Icon from './Icon.astro';
import { formatDate, readingTime, type Post } from '../lib/blog';

interface Props {
  post: Post;
  delay?: number;
}
const { post, delay = 0 } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const vt = `view-transition-name: post-${post.id.replace(/\W/g, '-')}`;
---

<article data-reveal style={`--d:${delay}`} class="card group flex h-full flex-col p-7">
  <p class="font-mono text-xs text-muted">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body)}
  </p>
  <h3 style={vt} class="mt-3 font-display text-2xl leading-tight font-bold tracking-tight text-balance">
    <a href={`/blog/${post.id}`} data-astro-prefetch="viewport" class="after:absolute after:inset-0 after:rounded-[inherit]">{title}</a>
  </h3>
  <p class="mt-3 flex-1 leading-relaxed text-muted">{description}</p>
  <div class="mt-6 flex items-end justify-between gap-4">
    <ul class="flex flex-wrap gap-1.5">
      {tags.map((t) => <li class="rounded-md bg-fg/5 px-2 py-0.5 font-mono text-[11px] text-muted">{t}</li>)}
    </ul>
    <span class="grid size-10 shrink-0 place-items-center rounded-full border border-line transition group-hover:rotate-45 group-hover:border-cyan group-hover:text-cyan">
      <Icon name="arrow" class="size-4" />
    </span>
  </div>
</article>
